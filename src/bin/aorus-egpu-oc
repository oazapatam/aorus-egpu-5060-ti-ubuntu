#!/usr/bin/env bash
# aorus-egpu-oc — control de potencia y relojes de la eGPU AORUS RTX 5060 Ti.
#
# ENTRYPOINT FINO (capa bin/): parsea argumentos, elige el caso de uso y sale.
# Ni una regla de negocio aquí — viven en src/domain/, orquestadas por
# src/app/overclock.sh. Ver docs/architecture.md.
set -uo pipefail

# Localiza el bootstrap tanto en el repo como instalado.
for _root in "$(dirname "$(readlink -f "$0")")/.." /usr/lib/aorus-egpu; do
  if [ -r "$_root/bootstrap.sh" ]; then . "$_root/bootstrap.sh"; break; fi
done
if ! declare -F aorus_use >/dev/null; then
  printf 'aorus-egpu-oc: no encuentro bootstrap.sh\n' >&2; exit 70
fi
aorus_use app/overclock
aorus_use app/telemetry

usage() {
  cat <<-USAGE
	aorus-egpu-oc — potencia y relojes de la eGPU (nunca de la GPU interna)

	Uso:
	  aorus-egpu-oc status              estado actual, límites y perfil aplicado
	  aorus-egpu-oc list               perfiles disponibles
	  aorus-egpu-oc apply <perfil>     aplica un perfil
	  aorus-egpu-oc reset              vuelve a valores de fábrica
	  aorus-egpu-oc verify [segundos]  mide si la eGPU calcula BIEN (no cambia
	                                   nada; carga la GPU, así que respeta el
	                                   gate de enlace igual que una escritura)
	  aorus-egpu-oc telemetry          foto viva de TODAS las GPUs en
	                                   clave=valor (uso, VRAM, temperatura,
	                                   relojes, throttling y procesos). Es lo
	                                   que consume el panel de nvidia-oc; solo
	                                   lectura, sin root y sin gate de enlace

	Opciones:
	  --dry-run              muestra el plan sin tocar el hardware
	  --force                aplica aunque el enlace esté degradado (BAJO TU
	                         RIESGO: apretar la eGPU con el enlace Gen1 ha
	                         congelado el host). NO abre el gate de verificación.
	  --verify-seconds <n>   presupuesto de la verificación numérica (def. 25)
	  -h, --help             esta ayuda

	Alcance: power limit y BLOQUEOS de reloj vía nvidia-smi (-pl/-lgc/-lmc), y
	OFFSETS de reloj (+/-MHz sobre stock) vía NVML. Los offsets SÍ funcionan en
	esta tarjeta: medido el 2026-11-02 con nvidia-ml-py, ventana de -1000 a
	+1000 MHz en el core y de -2000 a +6000 MHz en la memoria. Necesitan un
	python con pynvml; si vive en un venv, indícalo con AORUS_NVML_PYTHON. Sin
	pynvml, 'status' lo dice y los perfiles con offset se RECHAZAN en vez de
	fingir que se aplicaron. nvidia-settings no sirve aquí (necesita Xorg).

	Un offset POSITIVO no se da por bueno sin medirlo: se aplica, se verifica
	numéricamente y, si la GPU calcula mal, se revierte a stock en el acto y el
	perfil no se persiste. --force NO abre ese gate -un enlace degradado es un
	riesgo que puedes evaluar, un número mal calculado no lo puedes ni
	detectar- y tampoco se aplica de forma desatendida desde udev o systemd.
	Registro: /var/log/aorus-egpu/oc-verify.log

	ESTADO: en desarrollo, sin validar en hardware todavía.
	USAGE
}

cmd="" args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) export AORUS_OC_DRYRUN=1 ;;
    --force)   export AORUS_OC_FORCE=1 ;;
    --verify-seconds)
               shift
               [ $# -gt 0 ] || { printf '--verify-seconds necesita un valor\n' >&2; exit 2; }
               export AORUS_OC_VERIFY_SECONDS="$1" ;;
    -h|--help) usage; exit 0 ;;
    -*)        printf 'opción desconocida: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *)         if [ -z "$cmd" ]; then cmd="$1"; else args+=("$1"); fi ;;
  esac
  shift
done

gpu_available || { log_err "nvidia-smi no está disponible."; exit 69; }

# Las escrituras necesitan root; las lecturas no. Auto-elevamos solo cuando hace
# falta, para que `status` y `list` funcionen como usuario normal.
need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E -- "$0" "$@"
  fi
}

case "$cmd" in
  status|'') oc_status ;;
  list)      oc_list_profiles ;;
  apply)     [ "${AORUS_OC_DRYRUN:-0}" = "1" ] || need_root apply "${args[@]}"
             oc_apply "${args[0]:-}" ;;
  reset)     need_root reset
             oc_reset ;;
  # `verify` NO eleva: medir no escribe nada en la tarjeta, y torch no necesita
  # root. Elevar de más obligaría a correr el runtime CUDA como root sin motivo.
  verify)    oc_verify "${args[0]:-}" ;;
  # `telemetry` tampoco eleva: es la lectura más barata del paquete y el panel
  # la invoca una vez por segundo. Pedir root aquí convertiría el monitor en
  # algo que hay que autorizar para mirar.
  telemetry) tel_report ;;
  *)         printf 'comando desconocido: %s\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
