--- a/src/nvidia/arch/nvalloc/unix/include/os-interface.h
+++ b/src/nvidia/arch/nvalloc/unix/include/os-interface.h
@@ -116,6 +116,12 @@ void        NV_API_CALL  os_pci_remove                    (void *);
 //
 NvBool      NV_API_CALL  os_pci_is_disconnected           (void *);
 void        NV_API_CALL  os_pci_set_disconnected          (void *);
+//
+// AORUS R4 gate (Patch 0031): is this device the external Thunderbolt eGPU
+// (legit target of the recovery levers) vs the internal dGPU (never touch)?
+// Single source of truth gating every active lever. See os-pci.c.
+//
+NvBool      NV_API_CALL  os_pci_is_egpu_target            (void *);
 void*       NV_API_CALL  os_map_kernel_space              (NvU64, NvU64, NvU32);
 void        NV_API_CALL  os_unmap_kernel_space            (void *, NvU64);
 NV_STATUS   NV_API_CALL  os_flush_cpu_cache_all           (void);
diff --git a/src/nvidia/arch/nvalloc/unix/src/os.c b/src/nvidia/arch/nvalloc/unix/src/os.c
index 4793700..286016e 100644
--- a/src/nvidia/arch/nvalloc/unix/src/os.c
+++ b/src/nvidia/arch/nvalloc/unix/src/os.c
@@ -2022,7 +2022,12 @@ NvU32 osDevReadReg032(
     if (retval == 0xFFFFFFFFU && pGpu)
     {
         nv_state_t *nv = NV_GET_NV_STATE(pGpu);
+        /* AORUS R4 gate (Patch 0031): Q-active may declare the GPU lost and
+         * call os_pci_set_disconnected. Restrict that to the external eGPU —
+         * a transient 0xFFFFFFFF on the internal dGPU during RTD3/GC6 resume
+         * must NOT mark it disconnected (that was part of the Xid-79 cascade). */
         if (nv && nv->regs && nv->regs->map_u &&
+            os_pci_is_egpu_target(nv->handle) &&
             !pGpu->getProperty(pGpu, PDB_PROP_GPU_IS_LOST))
         {
             nv_priv_t *nvp = NV_GET_NV_PRIV(nv);
