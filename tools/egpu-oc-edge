class Journal:
    """Migas de pan con fsync. La última línea es el paso sospechoso."""

    def __init__(self, directory, dry_run=False):
        self.dir = Path(directory)
        self.dry_run = dry_run
        if not dry_run:
            self.dir.mkdir(parents=True, exist_ok=True)
        self.crumbs = self.dir / "10-breadcrumbs.log"
        self.steps = self.dir / "20-steps.jsonl"

    def _append(self, path, text):
        if self.dry_run:
            return
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())

    def crumb(self, text):
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        line = f"{stamp}\t{text}\n"
        self._append(self.crumbs, line)
        print(f"  · {text}", flush=True)

    def step(self, record):
        self._append(self.steps, json.dumps(record, ensure_ascii=False) + "\n")


class Hardware:
    """Lo único que toca el hardware. Escribe SIEMPRE por el helper NVML."""

    def __init__(self, bus, python, dry_run=False):
        self.bus = bus
        self.python = python
        self.dry_run = dry_run
        self.applied = {"gpu": 0, "mem": 0}
        self._restored = False

    def _nvml(self, *args):
        return run_cmd([self.python, "-I", str(NVML_HELPER), *args],
                       NVML_TIMEOUT)

    def caps(self):
        """((gmin, gmax), (mmin, mmax)) o None si no se puede afirmar."""
        rc, out, err = self._nvml("caps", self.bus)
        if rc != 0:
            return None, f"rc={rc} {err.strip() or out.strip()}"
        window = None
        for line in out.splitlines():
            if line.startswith("window="):
                parts = line.split("=", 1)[1].split()
                if len(parts) == 4:
                    try:
                        values = [int(p) for p in parts]
                    except ValueError:
                        return None, f"ventana ilegible: {line}"
                    window = ((values[0], values[1]), (values[2], values[3]))
        if window is None:
            return None, "el helper no declaró ventana"
        return window, ""

    def get(self):
        """(gpu_offset, mem_offset) tal como los lee NVML ahora mismo."""
        rc, out, err = self._nvml("get", self.bus)
        if rc != 0:
            return None, f"rc={rc} {err.strip() or out.strip()}"
        values = {}
        for token in out.split():
            if "=" in token:
                key, _, raw = token.partition("=")
                try:
                    values[key] = int(raw)
                except ValueError:
                    pass
        if "gpu_offset" not in values or "mem_offset" not in values:
            return None, f"lectura ilegible: {out.strip()}"
        return (values["gpu_offset"], values["mem_offset"]), ""

    def set(self, which, mhz):
        """rc 0 ok, 124 colgado (ABORTAR sin reintentar), otro = no aplicado."""
        if self.dry_run:
            self.applied[which] = mhz
            return 0, "dry-run"
        rc, out, err = self._nvml("set", self.bus, which, str(mhz))
        if rc == 0:
            self.applied[which] = mhz
        return rc, (err.strip() or out.strip())

    def apply(self, gpu_mhz, mem_mhz):
        """Pone los dos offsets. Devuelve (ok, detalle)."""
        for which, mhz in (("gpu", gpu_mhz), ("mem", mem_mhz)):
            if self.applied.get(which) == mhz and not self.dry_run:
                continue
            rc, detail = self.set(which, mhz)
            if rc == RC_HUNG:
                return False, f"NVML COLGADO escribiendo {which}={mhz}"
            if rc != 0:
                return False, f"no se aplicó {which}={mhz} ({detail})"
        return True, ""

    def restore(self):
        """Offsets a 0 y CONFIRMADO releyendo. Idempotente."""
        if self._restored or self.dry_run:
            self._restored = True
            return True
        self._restored = True
        ok = True
        for which in ("gpu", "mem"):
            rc, detail = self.set(which, 0)
            if rc != 0:
                ok = False
                print(f"  !! no pude devolver el offset de {which} a 0 "
                      f"(rc={rc} {detail})", file=sys.stderr, flush=True)
        read, err = self.get()
        if read is None:
            print(f"  !! no pude releer los offsets tras el reset ({err})",
                  file=sys.stderr, flush=True)
            self._restore_advice()
            return False
        if read != (0, 0):
            print(f"  !! los offsets NO están a 0: {read}",
                  file=sys.stderr, flush=True)
            self._restore_advice()
            return False
        print(f"  · offsets devueltos a 0 y confirmados {read}", flush=True)
        return ok

    @staticmethod
    def _restore_advice():
        """Qué hacer cuando la vuelta a 0 no se pudo confirmar.

        Antes esto solo imprimía "no pude", y "no pude" invita a asumir lo peor
        —que la tarjeta se quedó overclockeada— y a ir a arreglarlo a mano, que
        es justo la secuencia que cuelga el host. Lo que de verdad pasa está
        escrito aquí para que no haya que deducirlo con la tarjeta caída.
        """
        for line in (
            "",
            "  QUÉ SIGNIFICA ESTO",
            "  Si NVML no responde, lo más probable es que la tarjeta pida un",
            "  full-chip reset (`Xid 154`: GPU Reset Required). En ese estado no",
            "  se puede escribir el 0, pero TAMPOCO queda overclockeada: un",
            "  offset NVML no sobrevive a la re-enumeración del dispositivo, así",
            "  que la reconexión que lo recupera es la que lo deja a 0.",
            "",
            "  QUÉ HACER",
            "    1. Reconecta el cable Thunderbolt (quita y pon).",
            "    2. Comprueba:  aorus-egpu-oc status   -> offsets (0, 0)",
            "    3. Clasifica:  sudo aorus-egpu-health",
            "    4. Si el host se congeló: sudo aorus-egpu-postmortem",
            "",
            "  QUÉ NO HACER",
            "  NO intentes `remove`/`rescan`/FLR por sysfs para forzar el reset:",
            "  H2 documenta que esa secuencia con descriptores abiertos cuelga el",
            "  host entero. El cable es el camino.",
        ):
            print(line, file=sys.stderr, flush=True)


def link_verdict(bus):
    """Veredicto del enlace con LA REGLA DEL DOMINIO, no una copia de ella.

    Se delega en domain/link.sh a propósito: duplicar aquí el umbral de Gen/
    width sería una segunda fuente de verdad que podría divergir del gate que
    usa el paquete.
    """
    row = smi_query(bus, ("pcie.link.gen.max",))
    if row == RC_HUNG:
        return "hung", "nvidia-smi colgado leyendo la capacidad del enlace"
    gen_max = row[0] if row else ""
    try:
        width = (Path("/sys/bus/pci/devices") / bus.lower() /
                 "current_link_width").read_text().strip()
    except OSError:
        width = ""
    rc, out, err = run_cmd(
        ["bash", "-c",
         '. "$1" || exit 70; aorus_use domain/link || exit 70; '
         'domain_link_cap_verdict "$2" "$3"',
         "egpu-oc-edge", str(BOOTSTRAP), gen_max, width], 20)
    verdict = out.strip() or "unknown"
    if rc == 70:
        return "unknown", f"no pude cargar domain/link ({err.strip()})"
    return verdict, f"Gen{gen_max or '?'} negociado x{width or '?'}"


def nvrm_since(epoch):
    """Líneas NVRM/Xid del kernel desde `epoch`. Evidencia, no veredicto."""
    rc, out, _ = run_cmd(["journalctl", "-k", "-S", f"@{int(epoch)}",
                          "-o", "cat", "--no-pager"], 30)
    if rc != 0:
        return []
    return [line for line in out.splitlines()
            if "NVRM" in line or "Xid" in line]


def is_tunnel_loss(lines):
    """La firma de H23: lo que se cae es el DISPOSITIVO, no el reloj."""
    needles = ("fallen off the bus", "device disconnected", "Link Down",
               "Card not present")
    return any(needle in line for line in lines for needle in (needles))


class Sweep:
    def __init__(self, args, hw, journal, control):
        self.args = args
        self.hw = hw
        self.journal = journal
        self.control = control
        self.records = []
        self.aborted = None

    # -- un paso -------------------------------------------------------------
    def step(self, gpu_off, mem_off, seconds, split, label):
        """Aplica, mide, relee y clasifica. Devuelve el registro del paso."""
        record = {"label": label, "gpu_offset": gpu_off, "mem_offset": mem_off,
                  "seconds": seconds, "split": split,
                  "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")}

        # Gate de enlace ANTES de cada escritura: H23 dice que el túnel se cae
        # en reposo, y el paso anterior pudo dejar minutos de reposo por medio.
        verdict, info = link_verdict(self.hw.bus)
        record["link"] = f"{verdict} ({info})"
        if verdict != "healthy":
            record["status"] = INVALID
            record["detail"] = f"GATE de enlace: {verdict} ({info})"
            self.abort(f"enlace {verdict}: {info}")
            return self._finish(record)

        self.journal.crumb(f"APLICANDO {label}: gpu={gpu_off:+d} "
                           f"mem={mem_off:+d} ({seconds}s)")
        ok, detail = self.hw.apply(gpu_off, mem_off)
        if not ok:
            record["status"] = INVALID
            record["detail"] = detail
            if "COLGADO" in detail:
                self.abort(detail)
            return self._finish(record)

        if self.args.dry_run:
            record["status"] = "dry-run"
            return self._finish(record)

        t0 = time.time()
        self.journal.crumb(f"MIDIENDO  {label}: gpu={gpu_off:+d} "
                           f"mem={mem_off:+d} ({seconds}s) <- paso en curso")
        child = [self.args.python, "-I", str(Path(__file__).resolve()),
                 "step", "--bus", self.hw.bus, "--seconds", str(seconds),
                 "--split", str(split)]
        rc, out, err = run_cmd(child, seconds + CHILD_MARGIN_S)

        payload = None
        for line in out.splitlines():
            if line.startswith(CHILD_MARKER):
                payload = json.loads(line[len(CHILD_MARKER):])
        if payload:
            record.update(payload)
        else:
            record["status"] = FAIL_HARD
            record["detail"] = (f"el hijo no emitió resumen (rc={rc}) "
                                f"{err.strip()[:300]}")
        record["child_rc"] = rc

        if rc == RC_HUNG:
            # El hijo no volvió. No se reintenta y no se sigue midiendo: la
            # tarjeta puede estar wedged y insistir la deja peor.
            record["status"] = FAIL_HARD
            record["detail"] = "el hijo se COLGÓ (rc=124); abortando sin reintentar"
            self.abort(record["detail"])
            return self._finish(record)

        # Evidencia del kernel en la ventana del paso.
        nvrm = nvrm_since(t0 - 2)
        record["nvrm_lines"] = len(nvrm)
        if nvrm:
            record["nvrm_first"] = nvrm[0][:240]
        if is_tunnel_loss(nvrm):
            # No es culpa del reloj: es H23. La medición queda contaminada.
            record["status"] = FAIL_TUNNEL
            record["detail"] = ("firma de pérdida del dispositivo Thunderbolt "
                                "(H23): la medición queda contaminada")
            self.abort("pérdida del dispositivo Thunderbolt durante el paso")
            return self._finish(record)
        if nvrm and record.get("status") == PASS:
            # Pasó los bits pero el kernel dijo algo: no se declara "pasa" a
            # secas. Sin saber qué era, no hay evidencia limpia.
            record["status"] = INVALID
            record["detail"] = (f"{len(nvrm)} líneas NVRM durante un paso sin "
                                "errores numéricos; evidencia no limpia")

        # El offset se RELEE: un reset de GPU los borra, y un paso medido sin
        # el offset puesto no dice nada del offset.
        read, read_err = self.hw.get()
        record["offsets_after"] = read
        if read is None:
            record["status"] = INVALID
            record["detail"] = f"no pude releer los offsets ({read_err})"
        elif read != (gpu_off, mem_off):
            record["status"] = INVALID
            record["detail"] = (f"el offset cambió durante el paso: pedido "
                                f"({gpu_off},{mem_off}) leído {read}")

        # Efecto: ¿movió el reloj respecto al control?
        record["effect"] = self._effect(record, gpu_off, mem_off)
        return self._finish(record)

    def _effect(self, record, gpu_off, mem_off):
        """'nucleo', 'memoria', 'ambos', 'ninguno' o 'desconocido'.

        Un paso que pasa SIN mover el reloj no es margen conseguido: es un
        offset que el driver no ha aplicado al reloj real.
        """
        base = (self.control or {}).get("samples") or {}
        now = record.get("samples") or {}
        moved = []
        for key, name, requested in (("sm_mhz", "nucleo", gpu_off),
                                     ("mem_mhz", "memoria", mem_off)):
            if requested <= 0:
                continue
            ref, cur = base.get(key), now.get(key)
            if not ref or not cur:
                return "desconocido"
            # Umbral: la mitad de lo pedido, o 15 MHz, lo que sea mayor. El
            # reloj bajo carga oscila, así que un umbral pequeño daría falsos
            # "sí se movió".
            threshold = max(15, requested * 0.5)
            if (cur["max"] - ref["max"]) >= threshold:
                moved.append(name)
        if not moved:
            return "ninguno"
        return "ambos" if len(moved) == 2 else moved[0]

    def _finish(self, record):
        record["ended"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        self.records.append(record)
        self.journal.step(record)
        samples = record.get("samples") or {}
        sm = (samples.get("sm_mhz") or {}).get("max")
        power = (samples.get("power_w") or {}).get("max")
        temp = (samples.get("temp_c") or {}).get("max")
        extra = ""
        if sm is not None:
            extra = (f" | sm_max={sm:.0f}MHz pot_max={power}W temp={temp}C"
                     f" thr={samples.get('throttle')}"
                     f" efecto={record.get('effect', '?')}")
        self.journal.crumb(
            f"RESULTADO {record['label']}: {record['status']}"
            f" errores={record.get('errors')}"
            f" (gemm={record.get('gemm_errors')}/{record.get('gemm_iters')}it,"
            f" vram={record.get('vram_errors')}/{record.get('vram_chunks')}ch)"
            f"{extra}"
            + (f" | {record['detail']}" if record.get("detail") else ""))
        return record

    def abort(self, reason):
        if self.aborted is None:
            self.aborted = reason
            self.journal.crumb(f"ABORTO: {reason}")

    # -- escalera, bisección, confirmación -----------------------------------
    def _offsets_for(self, which, value):
        return (value, 0) if which == "gpu" else (0, value)

    def ladder(self, which, step, maximum, split, start=0):
        """Escalera gruesa hasta el PRIMER fallo. (ultimo_pass, primer_fallo).

        `start` arranca la escalera por encima de 0 cuando una medición
        ANTERIOR ya dejó territorio conocido (p.ej. H25 dejó +600 limpio y
        +675 colgando la tarjeta: repetir los ocho escalones de abajo no mide
        nada nuevo y cuesta minutos de carga). No se contabiliza como paso
        superado: `last_pass` sigue siendo 0 hasta que un escalón PASA en
        ESTA ejecución, porque un pass heredado de otra sesión no es
        evidencia de esta.
        """
        last_pass, first_fail = 0, None
        value = start if start > 0 else step
        while value <= maximum:
            gpu_off, mem_off = self._offsets_for(which, value)
            record = self.step(gpu_off, mem_off, self.args.ladder_seconds,
                               split, f"escalera {which} {value:+d}")
            if self.aborted:
                return last_pass, first_fail
            if record["status"] == PASS:
                last_pass = value
            else:
                first_fail = value
                return last_pass, first_fail
            value += step
        return last_pass, first_fail

    def bisect(self, which, low, high, res, split):
        """Afina entre un paso bueno y uno malo hasta la resolución pedida."""
        while high - low > res:
            mid = grid_floor((low + high) // 2, res)
            if mid <= low or mid >= high:
                break
            gpu_off, mem_off = self._offsets_for(which, mid)
            record = self.step(gpu_off, mem_off, self.args.ladder_seconds,
                               split, f"biseccion {which} {mid:+d}")
            if self.aborted:
                return low, high
            if record["status"] == PASS:
                low = mid
            else:
                high = mid
        return low, high

    def confirm(self, which, candidate, res, split, repeats):
        """n>=3 pasadas largas. Si una falla, el borde está más abajo."""
        descents = 0
        while candidate > 0 and descents <= self.args.max_descents:
            ok = True
            for attempt in range(1, repeats + 1):
                gpu_off, mem_off = self._offsets_for(which, candidate)
                record = self.step(
                    gpu_off, mem_off, self.args.confirm_seconds, split,
                    f"confirmacion {which} {candidate:+d} ({attempt}/{repeats})")
                if self.aborted:
                    return None
                if record["status"] != PASS:
                    ok = False
                    break
            if ok:
                return candidate
            candidate = grid_floor(candidate - res, res)
            descents += 1
        return None

    def confirm_pair(self, gpu_off, mem_off, split, repeats):
        """La COMBINACIÓN es una tercera variable: se confirma aparte."""
        for attempt in range(1, repeats + 1):
            record = self.step(
                gpu_off, mem_off, self.args.confirm_seconds, split,
                f"combinado gpu{gpu_off:+d} mem{mem_off:+d} ({attempt}/{repeats})")
            if self.aborted:
                return None
            if record["status"] != PASS:
                return False
        return True

    def coverage(self, which=None, value=None):
        """Cobertura acumulada de los pasos que PASARON en un punto dado."""
        iters = chunks = seconds = runs = 0
        for record in self.records:
            if record.get("status") != PASS:
                continue
            if which is not None:
                target = self._offsets_for(which, value)
                if (record["gpu_offset"], record["mem_offset"]) != target:
                    continue
            iters += record.get("gemm_iters") or 0
            chunks += record.get("vram_chunks") or 0
            seconds += record.get("elapsed_s") or 0
            runs += 1
        return {"gemm_iters": iters, "vram_chunks": chunks,
                "seconds": round(seconds, 1), "runs": runs}


