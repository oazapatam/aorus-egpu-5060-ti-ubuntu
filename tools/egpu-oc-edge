def build_parser():
    parser = argparse.ArgumentParser(
        prog="egpu-oc-edge",
        description="Mide el offset de reloj máximo que la eGPU sostiene sin "
                    "corromper bits.")
    sub = parser.add_subparsers(dest="mode")

    child = sub.add_parser("step", help="modo interno: una medición (no para humanos)")
    child.add_argument("--bus", required=True)
    child.add_argument("--seconds", type=int, required=True)
    child.add_argument("--split", type=float, required=True)

    parser.add_argument("--bus", default=None,
                        help="bus-id de la eGPU (por defecto se resuelve por device-id)")
    parser.add_argument("--python", default=sys.executable,
                        help="intérprete con torch+pynvml (por defecto el actual)")
    parser.add_argument("--out", default=None, help="directorio de evidencia")
    parser.add_argument("--dry-run", action="store_true",
                        help="imprime el plan sin tocar el hardware")
    parser.add_argument("--attended", action="store_true",
                        help="lo lanza una persona que va a leer el resultado "
                             "(necesario si tu terminal hereda INVOCATION_ID)")
    parser.add_argument("--domains", default="gpu,mem",
                        help="qué dominios medir: gpu, mem o gpu,mem")
    parser.add_argument("--no-combined", action="store_true",
                        help="no medir la combinación de los dos bordes")
    parser.add_argument("--gpu-start", type=int, default=0,
                        help="primer escalón del núcleo (0 = empezar en --gpu-step)")
    parser.add_argument("--gpu-step", type=int, default=75)
    parser.add_argument("--gpu-res", type=int, default=15)
    parser.add_argument("--gpu-max", type=int, default=1000)
    parser.add_argument("--mem-start", type=int, default=0,
                        help="primer escalón de la memoria (0 = empezar en --mem-step)")
    parser.add_argument("--mem-step", type=int, default=500)
    parser.add_argument("--mem-res", type=int, default=100)
    parser.add_argument("--mem-max", type=int, default=6000)
    parser.add_argument("--control-seconds", type=int, default=60)
    parser.add_argument("--ladder-seconds", type=int, default=20)
    parser.add_argument("--confirm-seconds", type=int, default=90)
    parser.add_argument("--repeats", type=int, default=3,
                        help="pasadas de confirmación (n>=3 lo pide la metodología)")
    parser.add_argument("--max-descents", type=int, default=3,
                        help="cuántos escalones se baja si la confirmación falla")
    parser.add_argument("--margin", type=float, default=0.20,
                        help="margen que se resta al borde para el valor recomendado")
    return parser


def estimate_minutes(args, domains):
    """Estimación honesta del reloj de pared, para poder decir no a tiempo."""
    per_step = CHILD_MARGIN_S * 0.15 + 10      # init de CUDA + NVML + journal
    total = args.control_seconds + per_step
    for which in domains:
        if which == "gpu":
            steps = (args.gpu_max - args.gpu_start) // args.gpu_step + 1
        else:
            steps = (args.mem_max - args.mem_start) // args.mem_step + 1
        total += steps * (args.ladder_seconds + per_step)
        total += 4 * (args.ladder_seconds + per_step)          # bisección
        total += args.repeats * (args.confirm_seconds + per_step)
    if not args.no_combined and len(domains) == 2:
        total += args.repeats * (args.confirm_seconds + per_step)
    return int(total / 60)


def main(argv):
    args = build_parser().parse_args(argv[1:])

    if args.mode == "step":
        return child_measure(args.bus, args.seconds, args.split)

    domains = [d.strip() for d in args.domains.split(",") if d.strip()]
    for which in domains:
        if which not in ("gpu", "mem"):
            print(f"dominio desconocido: {which} (gpu|mem)", file=sys.stderr)
            return 2

    bus = args.bus
    if bus is None:
        bus, err = resolve_egpu_bus()
        if bus is None:
            print(f"no encuentro la eGPU: {err}", file=sys.stderr)
            return 1

    out_dir = Path(args.out or ("/var/log/aorus-egpu/oc-edge/" +
                                time.strftime("%Y%m%d-%H%M%S")))
    journal = Journal(out_dir, dry_run=args.dry_run)
    hw = Hardware(bus, args.python, dry_run=args.dry_run)

    print(f"egpu-oc-edge — eGPU {bus}")
    print(f"evidencia: {out_dir}")
    print(f"estimación: ~{estimate_minutes(args, domains)} min de carga "
          f"(peor caso; para antes si falla pronto)\n")

    # La vuelta a 0 se registra ANTES de la primera escritura: por salida
    # normal, por excepción y por señal. Un offset dejado puesto es el fallo
    # que esta herramienta no puede permitirse.
    atexit.register(hw.restore)

    def on_signal(signum, _frame):
        print(f"\n(señal {signum}) devolviendo los offsets a 0...", flush=True)
        hw.restore()
        raise SystemExit(130)

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, on_signal)

    journal.crumb(f"ARRANQUE bus={bus} dominios={','.join(domains)} "
                  f"python={args.python}")
    window, problems = preflight(args, hw, journal)
    if problems:
        print("\nPREFLIGHT FALLIDO — no se ha tocado nada:", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        journal.crumb("PREFLIGHT FALLIDO: " + " | ".join(problems))
        return 2

    # La ventana del adaptador acota lo que se pide: nunca se intenta un valor
    # que la tarjeta no ha declarado aceptar.
    if window:
        args.gpu_max = min(args.gpu_max, window[0][1])
        args.mem_max = min(args.mem_max, window[1][1])
    journal.crumb(f"techos efectivos: nucleo +{args.gpu_max} memoria +{args.mem_max}")

    # El split del CONTROL y de las CONFIRMACIONES es el del gate del paquete
    # (0.55), para que el veredicto signifique lo mismo que el de
    # `aorus-egpu-oc verify`. En la ESCALERA se pondera hacia la fase que
    # discrimina el dominio que se está moviendo: el GEMM para el núcleo, el
    # patrón de VRAM para la memoria. Es más señal por segundo, y está dicho
    # aquí para que nadie lo lea como el mismo test.
    # MEDIDO el 2026-11-05 en esta tarjeta: una pasada COMPLETA de la fase de
    # VRAM (42 trozos, 10,5 GiB = 70% de la VRAM libre) cuesta ~18 s — ~5,5 s
    # llenando y ~12,5 s releyendo y comparando. De ahí los pesos:
    #   - escalera de MEMORIA: 0.90 de 20 s = 18 s, justo una pasada entera.
    #   - escalera de NÚCLEO : 0.10, testimonial a propósito. El discriminante
    #     del núcleo es el GEMM (1500 it en 6 s), y gastar ahí 5 s llenando
    #     VRAM que luego no da tiempo a releer no mide nada: el llenado se come
    #     el presupuesto y la comprobación se queda sin trozos.
    #   - control y CONFIRMACIONES: 0.55, el mismo valor que usa el gate del
    #     paquete, para que el veredicto signifique lo mismo que el de
    #     `aorus-egpu-oc verify`.
    gate_split = 0.55
    ladder_split = {"gpu": 0.10, "mem": 0.90}

    if args.dry_run:
        print("\nPLAN (nada de esto se ha ejecutado):")
        print(f"  control  : offset 0, {args.control_seconds}s, split {gate_split}")
        for which in domains:
            step_mhz = args.gpu_step if which == "gpu" else args.mem_step
            maximum = args.gpu_max if which == "gpu" else args.mem_max
            res = args.gpu_res if which == "gpu" else args.mem_res
            start = args.gpu_start if which == "gpu" else args.mem_start
            rungs = list(range(start or step_mhz, maximum + 1, step_mhz))
            print(f"  {which:3s}      : escalera {rungs} MHz "
                  f"({args.ladder_seconds}s/paso, split {ladder_split[which]})")
            print(f"             biseccion hasta {res} MHz, confirmacion "
                  f"n={args.repeats} de {args.confirm_seconds}s (split {gate_split})")
        if not args.no_combined and len(domains) == 2:
            print(f"  combinado: los dos recomendados juntos, n={args.repeats}")
        print("\nLa escalera PARA en el primer fallo, asi que lo real sera mas corto.")
        return 0

    sweep = Sweep(args, hw, journal, control=None)
    control = sweep.step(0, 0, args.control_seconds, gate_split, "control +0")
    sweep.control = control
    if not args.dry_run and control["status"] != PASS:
        print("\nEl CONTROL a offset 0 no pasó. Nada de lo que viniera después "
              "mediría el offset:", file=sys.stderr)
        print(f"  {control['status']}: {control.get('detail', '')}", file=sys.stderr)
        return 1

    summary = {"bus": bus, "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "python": args.python, "window": window,
               "control": control, "domains": {}, "combined": None,
               "aborted": None,
               "settings": {k: v for k, v in vars(args).items()
                            if k not in ("mode",)}}

    for which in domains:
        if sweep.aborted:
            break
        step_mhz = args.gpu_step if which == "gpu" else args.mem_step
        res = args.gpu_res if which == "gpu" else args.mem_res
        maximum = args.gpu_max if which == "gpu" else args.mem_max
        split = ladder_split[which]
        journal.crumb(f"--- dominio {which}: escalera de {step_mhz} MHz hasta "
                      f"+{maximum}, resolución {res} ---")
        start = args.gpu_start if which == "gpu" else args.mem_start
        last_pass, first_fail = sweep.ladder(which, step_mhz, maximum, split,
                                             start=start)
        edge = last_pass
        if first_fail is not None and not sweep.aborted:
            low, _high = sweep.bisect(which, last_pass, first_fail, res, split)
            edge = low
        confirmed = None
        if edge > 0 and not sweep.aborted:
            journal.crumb(f"--- dominio {which}: confirmación n={args.repeats} "
                          f"en {edge:+d} ---")
            confirmed = sweep.confirm(which, edge, res, gate_split, args.repeats)
        point = confirmed if confirmed is not None else edge
        recommended = grid_floor(point * (1 - args.margin), res) if point > 0 else 0
        effects = [r.get("effect") for r in sweep.records
                   if r.get("status") == PASS
                   and (r["gpu_offset"] if which == "gpu" else r["mem_offset"]) == point
                   and point > 0]
        summary["domains"][which] = {
            "last_pass": last_pass, "first_fail": first_fail, "edge": edge,
            "confirmed": confirmed, "res": res, "step": step_mhz,
            "ceiling_reached": first_fail is None,
            "effect": effects[0] if effects else "desconocido",
            "coverage": sweep.coverage(which, point),
            "recommended": recommended}

    gpu_data = summary["domains"].get("gpu")
    mem_data = summary["domains"].get("mem")
    if (not args.no_combined and not sweep.aborted and gpu_data and mem_data
            and gpu_data["recommended"] > 0 and mem_data["recommended"] > 0):
        journal.crumb("--- combinación de los dos valores recomendados "
                      "(tercera variable) ---")
        ok = sweep.confirm_pair(gpu_data["recommended"], mem_data["recommended"],
                                gate_split, args.repeats)
        summary["combined"] = {"gpu": gpu_data["recommended"],
                               "mem": mem_data["recommended"], "ok": bool(ok)}

    summary["aborted"] = sweep.aborted
    summary["ended"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    summary["steps"] = len(sweep.records)

    restored = hw.restore()
    summary["offsets_restored"] = restored

    if not args.dry_run:
        path = out_dir / "90-summary.json"
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(summary, handle, ensure_ascii=False, indent=2)
            handle.flush()
            os.fsync(handle.fileno())

    print_report(args, sweep, summary, out_dir)
    if sweep.aborted:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
