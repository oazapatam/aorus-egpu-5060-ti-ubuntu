def grid_floor(value, res):
    """Baja `value` al múltiplo de `res` inmediatamente inferior o igual."""
    return (int(value) // int(res)) * int(res)


def kill_grace(budget):
    """Gracia entre SIGTERM y SIGKILL. Espejo de domain_proc_kill_grace().

    La regla vive en src/domain/proc.sh, que es su única fuente y la que lleva
    test. Aquí está duplicada porque esto es python y aquello es bash; si una
    cambia, cambian las dos.
    """
    try:
        budget = int(budget)
    except (TypeError, ValueError):
        return 2
    return max(2, min(10, budget // 4))


def run_cmd(argv, timeout):
    """(rc, stdout, stderr). rc 124 si agotó el tiempo, como el resto del repo.

    NO USA subprocess.run(timeout=...), Y ESO ES EL ARREGLO DE UN DEFECTO REAL.
    El 2026-11-07, buscando el borde del reloj, el hijo que medía quedó ZOMBI
    IRREAPEABLE tras un `Xid 175` + `Xid 154` (`GPU Reset Required`): su líder
    había salido pero un hilo suyo seguía atascado dentro del driver, así que
    el núcleo no podía cerrarlo. `subprocess.run` mata al hijo cuando expira el
    plazo y DESPUÉS lo espera —sin plazo—, de modo que el padre se quedó en
    `wait4()` para siempre. Consecuencia: no se registró el ABORTO, los offsets
    NO volvieron a 0, no hubo informe y el barrido pareció "vivo" indefinidamente.
    El cuelgue de la tarjeta era lo que se estaba buscando; perder la reacción
    al cuelgue no.

    Garantía de aquí, y es un tope duro: esta función vuelve en
    `timeout + 2*gracia` como máximo, pase lo que pase.
      1. SIGTERM al agotar el presupuesto, y una gracia para que el hijo vacíe
         su salida —puede traer su resumen JSON ya calculado—;
      2. SIGKILL al GRUPO si sigue vivo (sesión propia, así que el grupo es
         suyo y no arrastra al padre);
      3. si NI ASÍ se puede reapear, se ABANDONA: se apunta en ABANDONED, se
         devuelve 124 y se sigue. Ningún programa de usuario saca a un hilo del
         estado-D; insistir es el martilleo que CLAUDE.md prohíbe, y esperarlo
         es el cuelgue que acabamos de arreglar. El proceso se lo lleva el
         reset del dispositivo.

    La salida va a FICHEROS TEMPORALES, no a tuberías: de un hijo abandonado no
    se puede leer una tubería sin volver a bloquearse, que es el mismo fallo por
    otra puerta. Con ficheros, lo que alcanzó a escribir se lee igual.
    """
    grace = kill_grace(timeout)
    try:
        out_f = tempfile.TemporaryFile(mode="w+", errors="replace")
        err_f = tempfile.TemporaryFile(mode="w+", errors="replace")
    except OSError as exc:
        return 1, "", f"{type(exc).__name__}: {exc}"

    def drain():
        texts = []
        for handle in (out_f, err_f):
            try:
                handle.seek(0)
                texts.append(handle.read())
            except (OSError, ValueError):
                texts.append("")
        return texts[0], texts[1]

    def wait_until(proc, limit):
        while proc.poll() is None and time.time() < limit:
            time.sleep(0.05)
        return proc.poll()

    try:
        try:
            proc = subprocess.Popen(argv, stdout=out_f, stderr=err_f,
                                    stdin=subprocess.DEVNULL,
                                    start_new_session=True)
        except OSError as exc:
            return 1, "", f"{type(exc).__name__}: {exc}"

        if wait_until(proc, time.time() + timeout) is not None:
            out, err = drain()
            return proc.returncode, out, err

        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(os.getpgid(proc.pid), sig)
            except (OSError, ProcessLookupError):
                try:
                    proc.send_signal(sig)
                except OSError:
                    pass
            if wait_until(proc, time.time() + grace) is not None:
                out, err = drain()
                return RC_HUNG, out, err or f"timeout ({sig.name} lo cerró)"

        ABANDONED.append(proc.pid)
        out, err = drain()
        return RC_HUNG, out, (
            f"{err}[pid {proc.pid} IRREAPEABLE: ni SIGKILL lo cerró, "
            f"seguramente con un hilo en estado-D dentro del driver. "
            f"LO ABANDONO para no bloquearme esperándolo; se lo llevará el "
            f"reset del dispositivo]")
    finally:
        for handle in (out_f, err_f):
            try:
                handle.close()
            except OSError:
                pass


def smi_query(bus, fields, timeout=SMI_TIMEOUT):
    """Una fila de nvidia-smi para la GPU en `bus`. None si no se pudo leer.

    Direccionado por BUS-ID, nunca por índice: los índices se reordenan entre
    arranques y en esta máquina el 0 es la GPU INTERNA.
    """
    rc, out, _ = run_cmd(["nvidia-smi", "-i", bus,
                          f"--query-gpu={','.join(fields)}",
                          "--format=csv,noheader,nounits"], timeout)
    if rc == RC_HUNG:
        return RC_HUNG
    if rc != 0 or not out.strip():
        return None
    return [c.strip() for c in out.strip().splitlines()[0].split(",")]


def as_float(text):
    try:
        return float(text)
    except (TypeError, ValueError):
        return None


