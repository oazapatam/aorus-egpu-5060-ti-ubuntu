def print_report(args, sweep, summary, out_dir):
    line = "=" * 78
    print(f"\n{line}\nRESULTADO — borde de overclock de la eGPU {summary['bus']}\n{line}")
    control = summary.get("control") or {}
    csam = control.get("samples") or {}
    print(f"\nControl a offset 0: {control.get('status')} — "
          f"{control.get('gemm_iters')} iteraciones GEMM, "
          f"{control.get('vram_chunks')} trozos de VRAM, "
          f"sm_max={(csam.get('sm_mhz') or {}).get('max')} MHz, "
          f"pot_max={(csam.get('power_w') or {}).get('max')} W, "
          f"temp_max={(csam.get('temp_c') or {}).get('max')} C")

    for which in ("gpu", "mem"):
        data = summary["domains"].get(which)
        if not data:
            continue
        nombre = "NÚCLEO (gpc)" if which == "gpu" else "MEMORIA (gddr7)"
        print(f"\n{nombre}")
        print(f"  último paso limpio en la escalera : {data['last_pass']:+d} MHz")
        fail = data["first_fail"]
        print(f"  primer paso que falló             : "
              f"{(f'{fail:+d} MHz') if fail is not None else 'ninguno dentro del rango probado'}")
        print(f"  borde tras bisección (res {data['res']} MHz)   : {data['edge']:+d} MHz")
        confirmed = data["confirmed"]
        print(f"  confirmado n={args.repeats} de {args.confirm_seconds}s      : "
              f"{(f'{confirmed:+d} MHz') if confirmed is not None else 'NO confirmado'}")
        print(f"  efecto medido en el reloj         : {data['effect']}")
        cov = data["coverage"]
        print(f"  cobertura en el punto confirmado  : {cov['runs']} pasadas, "
              f"{cov['gemm_iters']} iteraciones GEMM, {cov['vram_chunks']} "
              f"trozos de VRAM, {cov['seconds']} s")
        print(f"  RECOMENDADO (margen {int(args.margin * 100)}%)        : "
              f"{data['recommended']:+d} MHz")

    combined = summary.get("combined")
    if combined is not None:
        print(f"\nCOMBINADO núcleo {combined['gpu']:+d} + memoria "
              f"{combined['mem']:+d}: "
              f"{'pasa' if combined['ok'] else 'FALLA'}")

    if summary.get("aborted"):
        print(f"\n!! MEDICIÓN ABORTADA: {summary['aborted']}")
        print("   Los bordes de arriba son parciales: lo que no se midió, no se sabe.")

    if ABANDONED:
        print(f"\n!! PROCESOS ABANDONADOS: {', '.join(str(p) for p in ABANDONED)}")
        print("   Ni SIGKILL los cerró: seguramente con un hilo en estado-D dentro")
        print("   del driver. No se esperaron —esperarlos es el cuelgue que este")
        print("   tool arregló— y se los llevará el reset del dispositivo. Si siguen")
        print("   ahí tras reconectar el Thunderbolt, son zombis sin dueño y solo")
        print("   los limpia un reinicio; no consumen GPU.")
        print("   Comprobar:  ps -o pid,stat,wchan,cmd -p "
              + ",".join(str(p) for p in ABANDONED))

    print(f"\nLO QUE ESTE NÚMERO NO DICE\n{'-' * 26}")
    print("Cero errores en esta ventana no es 'seguro'. Esta tarjeta no tiene ECC,")
    print("y hay un caso documentado en Blackwell/GDDR7 donde la corrupción apareció")
    print("en la iteración 274.400 con un memtest de VRAM pasando 1.252 pasadas")
    print("limpias. Lo medido aquí es el borde GRUESO —dónde falla en minutos—, no")
    print("la cola de eventos raros. Para una carga de IA sin ECC, un resultado")
    print("silenciosamente incorrecto se propaga a los pesos sin dejar rastro.")
    print(f"\nEvidencia completa: {out_dir}")
    print(f"  10-breadcrumbs.log  pasos con fsync (la última línea es el sospechoso)")
    print(f"  20-steps.jsonl      un JSON por paso, con muestras de reloj/potencia")
    print(f"  90-summary.json     este resumen")


