def resolve_egpu_bus():
    """Bus-id de la eGPU por DEVICE-ID en sysfs, con la confirmación de R4.

    No se usa el índice de nvidia-smi: se reordena entre arranques y el 0 de
    esta máquina es la GPU INTERNA. La confirmación topológica se hace con el
    atributo `removable`, NO subiendo el árbol PCI a buscar el driver
    thunderbolt: el controlador TB es un HERMANO, no un ancestro.
    """
    root = Path("/sys/bus/pci/devices")
    found = []
    for entry in sorted(root.iterdir()):
        try:
            vendor = int((entry / "vendor").read_text().strip(), 16)
            device = int((entry / "device").read_text().strip(), 16)
        except (OSError, ValueError):
            continue
        if vendor != 0x10DE:
            continue
        if device == INTERNAL_DEVICE_ID:
            continue                     # la interna NUNCA es un target válido
        if device != EGPU_DEVICE_ID:
            continue
        removable = ""
        try:
            removable = (entry / "removable").read_text().strip()
        except OSError:
            pass
        found.append((entry.name, removable))
    if not found:
        return None, f"no hay ninguna GPU 10de:{EGPU_DEVICE_ID:04x} en el bus PCI"
    bus, removable = found[0]
    if removable != "removable":
        return None, (f"{bus} existe pero `removable` dice '{removable}': "
                      "no puedo confirmar que sea la tarjeta externa")
    return bus, ""


def preflight(args, hw, journal):
    """Todo lo que tiene que ser verdad ANTES de escribir el primer offset."""
    problems = []

    if not args.dry_run and os.geteuid() != 0:
        problems.append("escribir offsets NVML necesita root; relanza con sudo")

    # Igual que app/overclock.sh: un offset positivo NO se aplica desatendido.
    # Aquí el motivo es más fuerte todavía: esto los aplica a propósito hasta
    # que la tarjeta falla, y nadie leería el resultado desde una unit.
    # El heurístico es el mismo que app/overclock.sh (AORUS_OC_UNATTENDED
    # explícito + INVOCATION_ID como red). OJO con el falso positivo: en un
    # escritorio moderno el emulador de terminal ES una unit de systemd, así
    # que una sesión interactiva HEREDA INVOCATION_ID. Por eso aquí -y solo
    # aquí- hay una forma de decir "la está mirando una persona": pasar
    # --attended en la línea de órdenes, que es algo que una unit no hace sola.
    # El gate del PAQUETE no tiene este escape, y no debe tenerlo: allí el
    # riesgo es un arranque aplicando offsets sin testigo.
    if not args.attended and (os.environ.get("AORUS_OC_UNATTENDED") == "1"
                              or os.environ.get("INVOCATION_ID")):
        problems.append("parece ejecución DESATENDIDA (systemd/udev). Si la "
                        "estás mirando tú, pasa --attended")

    verdict, info = link_verdict(hw.bus)
    journal.crumb(f"enlace: {verdict} ({info})")
    if verdict != "healthy":
        problems.append(f"GATE de enlace: {verdict} ({info}); no hay --force aquí")

    window, err = hw.caps()
    if window is None:
        problems.append(f"la tarjeta no declara ventana de offsets ({err})")
    else:
        journal.crumb(f"ventana NVML: nucleo [{window[0][0]},{window[0][1]}] "
                      f"memoria [{window[1][0]},{window[1][1]}] MHz")

    read, read_err = hw.get()
    if read is None:
        problems.append(f"no puedo leer los offsets actuales ({read_err})")
    elif read != (0, 0):
        problems.append(f"la tarjeta YA tiene offsets puestos {read}: el control "
                        "no sería un control. Resetea con 'aorus-egpu-oc reset'")

    if not args.dry_run:
        rc, out, _ = run_cmd([args.python, "-I", str(VERIFY_HELPER),
                              "available"], 120)
        journal.crumb(f"verificador: {out.strip() or 'sin salida'} (rc={rc})")
        if rc != 0:
            problems.append("no hay verificador numérico (torch+CUDA) en "
                            f"{args.python}: sin evidencia no se mide nada")

    return window, problems


