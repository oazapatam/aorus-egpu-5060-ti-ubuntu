def load_verifier():
    """Importa el helper del puerto `verify` por ruta (lleva guion en el nombre).

    Se importa en vez de copiarse para que el borde se mida con EL MISMO
    verificador que usa el gate de `aorus-egpu-oc`.
    """
    spec = importlib.util.spec_from_file_location("aorus_gemm_integrity",
                                                  VERIFY_HELPER)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class Sampler(threading.Thread):
    """Muestrea reloj/potencia/temperatura/throttle BAJO CARGA.

    Existe para distinguir "el offset dio margen" de "el offset no hizo nada".
    Un paso que pasa sin mover el reloj no aporta margen, y decir lo contrario
    sería el mismo engaño por el que se retiró el perfil `performance`.
    """

    FIELDS = ("clocks.sm", "clocks.mem", "power.draw", "temperature.gpu",
              "clocks_throttle_reasons.active")

    def __init__(self, bus, interval=1.0):
        super().__init__(daemon=True)
        self.bus = bus
        self.interval = interval
        self._stop = threading.Event()
        self.sm = []
        self.mem = []
        self.power = []
        self.temp = []
        self.throttle = 0
        self.read_failures = 0
        self.hung = False

    def run(self):
        while not self._stop.is_set():
            row = smi_query(self.bus, self.FIELDS)
            if row == RC_HUNG:
                # nvidia-smi colgado: se deja de muestrear en el acto. Insistir
                # es martillear la tarjeta, y el muestreo es accesorio.
                self.hung = True
                return
            if row is None or len(row) < 5:
                self.read_failures += 1
            else:
                for dest, raw in ((self.sm, row[0]), (self.mem, row[1]),
                                  (self.power, row[2]), (self.temp, row[3])):
                    value = as_float(raw)
                    if value is not None:
                        dest.append(value)
                try:
                    self.throttle |= int(row[4], 0)
                except (TypeError, ValueError):
                    pass
            self._stop.wait(self.interval)

    def stop(self):
        self._stop.set()
        # Tope coherente con el peor caso de run_cmd (presupuesto + 2*gracia):
        # con el anterior (SMI_TIMEOUT + 5) el join podía rendirse ANTES de que
        # el muestreador terminara su última lectura y dejar un hilo escribiendo
        # mientras el paso siguiente ya estaba en marcha.
        self.join(timeout=SMI_TIMEOUT + 2 * kill_grace(SMI_TIMEOUT) + 2)

    def stats(self):
        def summarize(series):
            if not series:
                return None
            return {"med": round(statistics.median(series), 1),
                    "max": round(max(series), 1),
                    "n": len(series)}
        return {"sm_mhz": summarize(self.sm),
                "mem_mhz": summarize(self.mem),
                "power_w": summarize(self.power),
                "temp_c": summarize(self.temp),
                "throttle": f"0x{self.throttle:x}",
                "sample_failures": self.read_failures,
                "smi_hung": self.hung}


def child_measure(bus, seconds, split):
    """Una medición completa. Imprime una línea CHILD_MARKER + JSON y sale.

    Códigos de salida: 0 pasa, 1 falla numérica, 2 sin evidencia, 3 fallo duro
    (excepción del runtime CUDA: offset demasiado agresivo o tarjeta ida).
    """
    result = {"status": INVALID, "detail": "", "errors": None,
              "gemm_errors": None, "gemm_iters": 0,
              "vram_errors": None, "vram_chunks": 0,
              "elapsed_s": 0.0, "samples": {}}

    def emit(rc):
        print(CHILD_MARKER + json.dumps(result), flush=True)
        return rc

    verifier = load_verifier()
    if verifier is None:
        result["detail"] = f"no puedo importar {VERIFY_HELPER}"
        return emit(2)

    torch = verifier.load_torch()
    if torch is None:
        result["detail"] = "sin torch"
        return emit(2)
    try:
        if not torch.cuda.is_available():
            result["detail"] = "cuda no disponible"
            return emit(2)
        ordinal = verifier.pick_ordinal(torch, bus)
    except Exception as exc:                                # noqa: BLE001
        result["detail"] = f"cuda_init {type(exc).__name__}: {exc}"
        return emit(2)
    if ordinal is None:
        # NO es "pasa": es que no hemos encontrado la eGPU. Un `cuda:0` aquí
        # mediría la GPU INTERNA y daría un pass sin haber tocado la externa.
        result["detail"] = f"ninguna GPU de torch está en {bus}"
        return emit(2)

    # set_device explícito: las fases llaman a torch.cuda.synchronize() sin
    # argumento, que sincroniza el dispositivo ACTUAL. Sin esto el actual es el
    # ordinal 0 —la GPU interna— y los sync no sincronizan lo que se mide.
    torch.cuda.set_device(ordinal)
    device = torch.device(f"cuda:{ordinal}")
    result["ordinal"] = ordinal
    result["device_name"] = torch.cuda.get_device_name(ordinal)

    sampler = Sampler(bus)
    sampler.start()
    start = time.monotonic()
    try:
        vram_errors, chunks = verifier.vram_phase(
            torch, device, ordinal, start + seconds * split)
        gemm_errors, iters = verifier.gemm_phase(torch, device, start + seconds)
    except Exception as exc:                                # noqa: BLE001
        # Un fallo del runtime a mitad es un FALLO DURO del offset, no falta de
        # evidencia: el offset estaba puesto y la tarjeta no completó el
        # trabajo. Se distingue del fallo numérico porque es ruidoso.
        result["status"] = FAIL_HARD
        result["detail"] = f"{type(exc).__name__}: {exc}"
        result["elapsed_s"] = round(time.monotonic() - start, 1)
        sampler.stop()
        result["samples"] = sampler.stats()
        return emit(3)
    finally:
        if sampler.is_alive():
            sampler.stop()

    result["samples"] = sampler.stats()
    result["elapsed_s"] = round(time.monotonic() - start, 1)
    result["vram_errors"] = vram_errors
    result["vram_chunks"] = chunks
    result["gemm_errors"] = gemm_errors
    result["gemm_iters"] = iters
    result["errors"] = vram_errors + gemm_errors
    if iters + chunks == 0:
        result["status"] = INVALID
        result["detail"] = "no se midió ni una iteración"
        return emit(2)
    if result["errors"]:
        result["status"] = FAIL_NUM
        return emit(1)
    result["status"] = PASS
    return emit(0)


