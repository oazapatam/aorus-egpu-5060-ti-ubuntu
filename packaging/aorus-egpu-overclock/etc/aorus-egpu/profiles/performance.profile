# desc: 180 W (máximo de la tarjeta) y reloj gráfico anclado alto
# OJO: es el perfil que más calienta la caja. No es un overclock por encima de
# stock (eso no es posible en este sistema, ver docs/overclock.md): sube el
# techo de potencia al máximo de fábrica y evita que el reloj baje por debajo
# de 1800 MHz en cargas CUDA sostenidas.
power_limit_w=180
gpu_clock_min_mhz=1800
gpu_clock_max_mhz=3090
