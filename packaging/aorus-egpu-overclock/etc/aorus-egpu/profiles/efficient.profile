# desc: 150 W, reloj limitado — menos calor y menos estrés sobre el enlace TB
# Recomendado para esta caja. El límite inferior de la tarjeta es 150 W; bajar
# potencia reduce el consumo y la temperatura sin tocar la memoria, y es la
# opción más conservadora con un enlace Thunderbolt que ya entrena marginal.
power_limit_w=150
gpu_clock_min_mhz=500
gpu_clock_max_mhz=2400
